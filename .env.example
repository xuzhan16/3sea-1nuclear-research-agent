# ===== 三海一核·智能调研 Agent 环境配置模板 =====
# 复制本文件为 .env 并填入你的密钥（.env 已被 .gitignore 排除，不会上传到 GitHub）

# ---- 大模型：DeepSeek（国内直连）----
DEEPSEEK_API_KEY=
FAST_LLM=deepseek:deepseek-chat
SMART_LLM=deepseek:deepseek-chat
STRATEGIC_LLM=deepseek:deepseek-chat

# ---- 搜索：Tavily（国内直连，免费 1000 次/月，稳定）----
RETRIEVER=tavily
TAVILY_API_KEY=

# 备选搜索：DuckDuckGo（免费无需 key，但需开代理，且机房 IP 可能被风控）
# 切换方法：把上面 RETRIEVER 改成 duckduckgo

# ---- 报告语言 ----
LANGUAGE=chinese

# ---- 无 OpenAI key 时的 embedding 占位（初始化不报错，且实际不会调用）----
EMBEDDING=custom:text-embedding-3-small

# ---- 关闭 embedding 相似度过滤（文档小于该字符数时直接用原文）----
COMPRESSION_THRESHOLD=1000000
